        echo '<div class="wrap"><h1>VP Onboarding</h1><p>Access denied.</p></div>';
        return;
    }

    ?>
    <div class="wrap vp-onboarding-admin">
        <h1>VP Onboarding</h1>
        <div id="vp-onboarding-root" class="vp-onboarding-root"></div>
    </div>
    <?php
