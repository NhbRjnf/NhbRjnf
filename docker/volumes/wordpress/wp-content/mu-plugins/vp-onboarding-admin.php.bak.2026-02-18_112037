function vp_onboarding_admin_get_env($key, $default = '') {
    $v = getenv($key);
    if ($v === false || $v === null || $v === '') {
        return $default;
    }
    return $v;
}

function vp_onboarding_admin_get_directus_base_url() {
    $url = vp_onboarding_admin_get_env('VP_DIRECTUS_URL', '');
    return rtrim((string) $url, '/');
}

function vp_onboarding_admin_get_directus_token() {
    return (string) vp_onboarding_admin_get_env('VP_DIRECTUS_TOKEN', '');
}

function vp_onboarding_admin_get_directus_collection() {
    return (string) vp_onboarding_admin_get_env('VP_ONBOARDING_COLLECTION', 'vp_onboarding_requests');
}

function vp_onboarding_admin_get_role_map() {
    return [
        'dentist' => (string) vp_onboarding_admin_get_env('VP_DX_ROLE_DENTIST', ''),
        'auto' => (string) vp_onboarding_admin_get_env('VP_DX_ROLE_AUTO', vp_onboarding_admin_get_env('VP_DX_ROLE_AUTO_SPECIALIST', '')),
        'location' => (string) vp_onboarding_admin_get_env('VP_DX_ROLE_LOCATION', vp_onboarding_admin_get_env('VP_DX_ROLE_LOCATION_MANAGER', '')),
        'partner' => (string) vp_onboarding_admin_get_env('VP_DX_ROLE_PARTNER', vp_onboarding_admin_get_env('VP_DX_ROLE_PARTNER_MANAGER', '')),
        'moderator' => (string) vp_onboarding_admin_get_env('VP_DX_ROLE_VP_MODERATOR', ''),
        'admin' => (string) vp_onboarding_admin_get_env('VP_DX_ROLE_VP_ADMIN', ''),
        'car_owner' => (string) vp_onboarding_admin_get_env('VP_DX_ROLE_CAR_OWNER', vp_onboarding_admin_get_env('VP_DX_ROLE_API_PUBLIC', '')),
    ];
}

function vp_onboarding_admin_user_can_access() {
    return current_user_can('manage_options');
}

function vp_onboarding_admin_log_directus_error($context, WP_Error $error, $extra = []) {
    $data = $error->get_error_data();
    if (!is_array($data)) {
        $data = [];
    }

    $safe = [
        'context' => $context,
        'error' => $error->get_error_message(),
        'http_code' => isset($data['http_code']) ? (int) $data['http_code'] : 0,
        'directus_message' => isset($data['directus_message']) ? (string) $data['directus_message'] : '',
        'path' => isset($data['path']) ? (string) $data['path'] : '',
        'method' => isset($data['method']) ? (string) $data['method'] : '',
    ];

    foreach ($extra as $k => $v) {
        $safe[$k] = $v;
    }

    error_log('[VP Onboarding] ' . wp_json_encode($safe, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES));
}

function vp_onboarding_admin_send_wp_error(WP_Error $error, $default_status = 500) {
    $data = $error->get_error_data();
    if (!is_array($data)) {
        $data = [];
    }

    $status = isset($data['http_code']) ? (int) $data['http_code'] : (int) $default_status;
    if ($status < 100) {
        $status = (int) $default_status;
    }

    $payload = [
        'message' => $error->get_error_message(),
    ];

    if (!empty($data['directus_message'])) {
        $payload['directus_message'] = $data['directus_message'];
    }

    wp_send_json_error($payload, $status);
}

function vp_dx_request($method, $path, $token, $body = null, $timeout = 15) {
    $base = vp_onboarding_admin_get_directus_base_url();
    if ($base === '') {
        return new WP_Error('vp_missing_directus_url', 'Directus URL is not configured (VP_DIRECTUS_URL).', ['http_code' => 500]);
    }

    $token = (string) $token;
    if ($token === '') {
        return new WP_Error('vp_missing_directus_token', 'Directus token is not configured (VP_DIRECTUS_TOKEN).', ['http_code' => 500]);
    }

    $url = $base . $path;

    $args = [
        'method' => strtoupper($method),
        'timeout' => (int) $timeout,
        'headers' => [
            'Authorization' => 'Bearer ' . $token,
        ],
    ];

    if ($body !== null) {
        $args['headers']['Content-Type'] = 'application/json';
        $args['body'] = wp_json_encode($body, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
    }

    $res = wp_remote_request($url, $args);
    if (is_wp_error($res)) {
        return new WP_Error('vp_directus_transport_error', $res->get_error_message(), ['http_code' => 502, 'path' => $path, 'method' => strtoupper($method)]);
    }

    $code = (int) wp_remote_retrieve_response_code($res);
    $raw = (string) wp_remote_retrieve_body($res);

    $json = null;
    if ($raw !== '') {
        $json = json_decode($raw, true);
    }

    if ($code < 200 || $code >= 300) {
        $directus_message = '';
        if (is_array($json)) {
            if (!empty($json['errors'][0]['message'])) {
                $directus_message = (string) $json['errors'][0]['message'];
            } elseif (!empty($json['message'])) {
                $directus_message = (string) $json['message'];
            }
        }

        $msg = 'Directus HTTP ' . $code;
        if ($directus_message !== '') {
            $msg .= ': ' . $directus_message;
        }

        return new WP_Error('vp_directus_http_error', $msg, [
            'http_code' => $code,
            'path' => $path,
            'method' => strtoupper($method),
            'directus_message' => $directus_message,
        ]);
    }

    return $json;
}

function vp_dx_email_is_directus_compatible($email) {
    $email = trim((string) $email);
    if ($email === '') {
        return false;
    }

    if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
        return false;
    }

    $at = strrpos($email, '@');
    if ($at === false) {
        return false;
    }

    $domain = substr($email, $at + 1);
    if ($domain === '' || strpos($domain, '.') === false) {
        return false;
    }

    if (preg_match('/\.(local|localhost)$/i', $domain)) {
        return false;
    }

    return true;
}

