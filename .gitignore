# --- ARCHIVES / TEMP ---
archive_*.zip
*.zip

# --- BACKUPS ---
backup/
backups/

# --- SECRETS ---
docker/.env
**/.env
*.pem
*.key

# --- LOGS ---
logs/
*.log

# --- EDITORS / OS ---
.DS_Store
*.swp
*.swo

# --- DATABASES (docker volumes) ---
docker/volumes/postgres/
docker/volumes/mariadb/

# --- DOCKER RUNTIME / VOLUMES ---
# По умолчанию игнорим все volumes
docker/volumes/**
# Но разрешаем код и конфиг, который реально правим и который нужен CODEX

# --- DIRECTUS ---
# Extensions (наш код) — в git
!docker/volumes/directus_extensions/
!docker/volumes/directus_extensions/**
# Uploads (медиа) — не в git
docker/volumes/directus_uploads/

# --- WORDPRESS ---
# Разрешаем структуру WP
!docker/volumes/wordpress/
!docker/volumes/wordpress/**

# Но runtime штуки WP не коммитим:
docker/volumes/wordpress/wp-content/uploads/
docker/volumes/wordpress/wp-content/cache/
docker/volumes/wordpress/wp-config.php

# Разрешаем кодовую часть WP целиком (без перечисления файлов)
!docker/volumes/wordpress/wp-content/
!docker/volumes/wordpress/wp-content/mu-plugins/
!docker/volumes/wordpress/wp-content/mu-plugins/**
!docker/volumes/wordpress/wp-content/themes/
!docker/volumes/wordpress/wp-content/themes/**
!docker/volumes/wordpress/wp-content/plugins/
!docker/volumes/wordpress/wp-content/plugins/**

# PWA файлы (если лежат в корне wordpress volume)
!docker/volumes/wordpress/manifest.json
!docker/volumes/wordpress/service-worker.js

# --- SECURITY ---
SECURITY.md

# --- RUNTIME LOG SNAPSHOTS (safe to commit) ---
runtime/
!runtime/
!runtime/logs/
!runtime/logs/**
!runtime/directus/
!runtime/directus/**
runtime/logs/*.raw
runtime/logs/*.full
runtime/logs/*.gz
